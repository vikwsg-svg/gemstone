        "tags": [
          "Scan API"
        ],
        "summary": "Submit a CSV of items to scan in batch",
        "description": "Upload a CSV (multipart field `file`), one item per row. Required column: `photo_urls` (1-5 public https links separated by `|`). Optional columns, passed to the scan as details: `row_id`, `item_type`, `metal_type`, `metal_purity`, `metal_weight_grams`, `brand`, `signed`, `era`, `condition`, `lab`, `lab_report_number`, `notes`. The job runs asynchronously; poll the status endpoint, then download the results CSV.",
        "operationId": "create_batch_scans_batch_post",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional. Retrying a POST with the same key and body returns the original response (with `Idempotent-Replayed: true`) instead of running and billing a second scan. Keys are scoped to your account and kept for 24 hours.",
              "title": "Idempotency-Key"
            },
            "description": "Optional. Retrying a POST with the same key and body returns the original response (with `Idempotent-Replayed: true`) instead of running and billing a second scan. Keys are scoped to your account and kept for 24 hours."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_batch_scans_batch_post"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchJobResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
