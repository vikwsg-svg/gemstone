{
  "openapi": "3.1.0",
  "info": {
    "title": "GemstoneAI Enterprise API",
    "description": "\nThe GemstoneAI Enterprise API: the pricing and verification layer for jewelry.\n\nThe **Scan API** is today's GemstoneAI scan result, enhanced for businesses. Send 1-5 photos of\na piece of jewelry or a loose stone (plus anything you already know) and get the whole result in\none response: the identification (observations, alternatives, open questions, next evidence),\nthe price context, and the comparables behind it, each tagged as an asking price or a realized\nsale.\n\n* **Authentication:** `Authorization: Bearer gsk_...` (or `X-API-Key`). Keys are scoped per product.\n* **Sandbox:** `gsk_test_` keys return example scan results; responses carry `synthetic_data: true`.\n* **No guessing:** no price with fewer than 5 comparables, or when the item can't be identified;\n  the reason is always given.\n* **Audit:** every scan is stored and retrievable by `scan_id`.\n* **Versioned:** every result is stamped with the scan `model_version`; you can pin one.\n* **Idempotency:** send `Idempotency-Key` on POSTs to make retries safe.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/scans": {
      "post": {
        "tags": [
          "Scan API"
        ],
        "summary": "Scan a piece of jewelry or a loose stone",
        "description": "Today's GemstoneAI scan result, in one response: the identification (observations, alternatives, open questions, next evidence), the price context, and the comparables behind it (each an asking price or a realized sale). Send 1-5 photos of one item, plus any details you already know. **No price with fewer than 5 comparables** or when the item can't be identified; the reason is always given. If the scan is still running, the response is `202` with `status: processing`: retrieve it with `GET /scans/{scan_id}`. Every scan is stored and retrievable.",
        "operationId": "create_scan_scans_post",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional. Retrying a POST with the same key and body returns the original response (with `Idempotent-Replayed: true`) instead of running and billing a second scan. Keys are scoped to your account and kept for 24 hours.",
              "title": "Idempotency-Key"
            },
            "description": "Optional. Retrying a POST with the same key and body returns the original response (with `Idempotent-Replayed: true`) instead of running and billing a second scan. Keys are scoped to your account and kept for 24 hours."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            }
          },
          "202": {
            "description": "Accepted; the scan is still running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the required product scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Scan service unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
