{
  "openapi": "3.1.0",
  "info": {
    "title": "GemstoneAI Enterprise API",
    "description": "\nThe GemstoneAI Enterprise API: the pricing and verification layer for colored gemstones.\n\n**Comps** (this version) returns a defensible value for a stone with the evidence attached:\na price band in your chosen valuation basis, the comparables behind it (each tagged as a\nrealized sale or an asking price), a confidence score with reason codes, and scenario pricing\nfor unknown treatment or origin.\n\n* **Authentication:** `Authorization: Bearer gsk_...` (or `X-API-Key`). Keys are scoped per product.\n* **Sandbox:** `gsk_test_` keys run against synthetic stones; responses carry `synthetic_data: true`.\n* **No guessing:** fewer than 5 qualifying comparables means no price (`insufficient_data`).\n* **Audit:** every valuation is stored and retrievable by `valuation_id`.\n* **Reproducibility:** every response is stamped with `model_version`; pin one per request or per account.\n* **Idempotency:** send `Idempotency-Key` on POSTs to make retries safe.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/valuations": {
      "post": {
        "tags": [
          "Comps"
        ],
        "summary": "Value a stone",
        "description": "Returns a low/mid/high price band per carat and in total, in the requested valuation basis, with the comparables used, a confidence score with reason codes, and scenario pricing for unknown treatment or origin. **If fewer than 5 comparables qualify, no price is returned**: `status` is `insufficient_data` and the closest comps are listed. Every valuation is stored and retrievable by `valuation_id`.",
        "operationId": "create_valuation_valuations_post",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional. Retrying a POST with the same key and body returns the original response (with `Idempotent-Replayed: true`) instead of creating and billing a second valuation. Keys are scoped to your account and kept for 24 hours.",
              "title": "Idempotency-Key"
            },
            "description": "Optional. Retrying a POST with the same key and body returns the original response (with `Idempotent-Replayed: true`) instead of creating and billing a second valuation. Keys are scoped to your account and kept for 24 hours."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValuationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValuationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the required product scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Pricing engine unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
