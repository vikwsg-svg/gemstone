        "summary": "Submit a CSV of stones for batch valuation",
        "description": "Upload a CSV (multipart field `file`). Required columns: `variety`, `carat`, `shape`. Optional: `row_id`, `species`, `color_grade`, `clarity`, `treatment`, `origin`, `lab`, `lab_report_number`, `length_mm`, `width_mm`, `depth_mm`, `valuation_basis`. The job runs asynchronously; poll the status endpoint, then download the results CSV. The whole batch is pinned to one model version.",
        "operationId": "create_batch_valuations_batch_post",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional. Retrying a POST with the same key and body returns the original response (with `Idempotent-Replayed: true`) instead of creating and billing a second valuation. Keys are scoped to your account and kept for 24 hours.",
              "title": "Idempotency-Key"
            },
            "description": "Optional. Retrying a POST with the same key and body returns the original response (with `Idempotent-Replayed: true`) instead of creating and billing a second valuation. Keys are scoped to your account and kept for 24 hours."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_batch_valuations_batch_post"
