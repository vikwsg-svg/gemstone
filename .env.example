# Environment Configuration

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# PostgreSQL
DATABASE_URL=postgresql://gemstone:gemstone@localhost:5432/gemstone

# Storage
STORAGE_BACKEND=local
# For S3/MinIO:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=gemstone-data
# S3_REGION=us-east-1

# Local storage paths
LOCAL_STORAGE_ROOT=./data
RAW_HTML_PATH=./data/raw/html
IMAGES_PATH=./data/images
VALIDATED_PATH=./data/validated

# Crawler settings
DEFAULT_USER_AGENT=GemstoneBot/1.0 (+https://example.com/bot; research purposes)
RESPECT_ROBOTS_TXT=true
DEFAULT_CRAWL_DELAY=2.0
MAX_CONCURRENT_PER_DOMAIN=2
MAX_REQUESTS_PER_SECOND=1.0
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Compliance
REQUIRE_ROBOTS_ALLOW=true
REQUIRE_TOS_ALLOW=false
DOMAIN_ALLOWLIST=
DOMAIN_DENYLIST=

# Validation thresholds
MIN_IMAGE_COUNT=2
MIN_IMAGE_RESOLUTION=600
MIN_CARAT=0.05
MAX_CARAT=50.0
PHASH_DISTANCE_THRESHOLD=8

# Optional LLM (for text normalization only)
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-3.5-turbo
USE_LLM_NORMALIZATION=false
